{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-analytics-platform.dev/schemas/phase-5/event-batch-v2.schema.json",
  "title": "Event Batch V2 Draft",
  "type": "object",
  "properties": {
    "schema_version": { "const": 2 },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "page-view-event-v2.schema.json" }
    }
  },
  "required": ["schema_version", "events"],
  "additionalProperties": true
}
