{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-analytics-platform.dev/schemas/phase-5/page-view-event-v2.schema.json",
  "title": "Page View Event V2 Draft",
  "type": "object",
  "properties": {
    "schema_version": { "const": 2 },
    "event_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "type": { "const": "page_view" },
    "site_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
    "visitor_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "context_schema_version": { "const": 1 },
    "occurred_at": { "type": "integer", "minimum": 0 },
    "path": { "type": "string", "pattern": "^/", "maxLength": 2048 },
    "url": { "type": "string", "format": "uri", "maxLength": 4096 },
    "title": { "type": "string", "maxLength": 512 },
    "referrer": { "type": "string", "format": "uri-reference", "maxLength": 4096 },
    "context": { "$ref": "browser-context-v1.schema.json" }
  },
  "required": ["schema_version", "event_id", "type", "site_id", "occurred_at", "path"],
  "allOf": [
    {
      "if": { "properties": { "context": {} }, "required": ["context"] },
      "then": {
        "properties": { "context_schema_version": {} },
        "required": ["context_schema_version"]
      }
    },
    {
      "if": {
        "properties": { "context_schema_version": {} },
        "required": ["context_schema_version"]
      },
      "then": { "properties": { "context": {} }, "required": ["context"] }
    }
  ],
  "additionalProperties": true
}
