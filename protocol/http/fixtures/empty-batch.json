  },
  "request": {
    "method": "POST",
    "path": "/v1/events",
    "headers": {
      "content-type": "application/json",
      "origin": "https://www.example.com",
      "x-ingest-key": "public-key-production-example"
    },
    "body": "{\"schema_version\":1,\"events\":[]}"
  },
  "expected": {
    "status": 400,
    "headers": {
      "content-type": "application/json",
      "access-control-allow-origin": "https://www.example.com",
      "vary": "Origin"
