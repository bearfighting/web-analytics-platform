{
  "id": "preflight-invalid-method",
  "setup": {
    "config": "../config/collector.example.toml"
  },
  "request": {
    "method": "OPTIONS",
    "path": "/v1/events",
    "headers": {
      "origin": "https://www.example.com",
      "access-control-request-method": "GET",
      "access-control-request-headers": "content-type, x-ingest-key"
    },
    "body": ""
  },
  "expected": {
    "status": 403,
    "headers": {
      "content-type": "application/json",
      "vary": "Origin"
    },
    "body": "{\"error\":{\"code\":\"origin_not_allowed\",\"message\":\"Origin is not allowed\"}}"
  }
}
