{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-analytics-platform.dev/contracts/configuration/current/capabilities.schema.json",
  "title": "Site Capability Configuration",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "site_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "page_views": {
          "$ref": "#/$defs/capability"
        },
        "browser_context": {
          "$ref": "#/$defs/capability"
        },
        "anonymous_visitors": {
          "$ref": "#/$defs/capability"
        },
        "sessions": {
          "$ref": "#/$defs/capability"
        },
        "dimensions": {
          "$ref": "#/$defs/capability"
        },
        "custom_events": {
          "$ref": "#/$defs/capability"
        },
        "web_vitals": {
          "$ref": "#/$defs/capability"
        },
        "conversions": {
          "$ref": "#/$defs/capability"
        },
        "funnels": {
          "$ref": "#/$defs/capability"
        },
        "geo": {
          "$ref": "#/$defs/capability"
        }
      },
      "required": [
        "page_views",
        "browser_context",
        "anonymous_visitors",
        "sessions",
        "dimensions",
        "custom_events",
        "web_vitals",
        "conversions",
        "funnels",
        "geo"
      ],
      "additionalProperties": false
    },
    "consent_policy": {
      "const": "required"
    },
    "privacy_constraints": {
      "const": ["no_ip_persistence", "no_fingerprinting", "consent_required"]
    }
  },
  "required": [
    "schema_version",
    "site_id",
    "version",
    "updated_at",
    "capabilities",
    "consent_policy",
    "privacy_constraints"
  ],
  "additionalProperties": false,
  "$defs": {
    "capability": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "settings": {
          "type": "object",
          "maxProperties": 0,
          "additionalProperties": false
        }
      },
      "required": ["enabled", "settings"],
      "additionalProperties": false
    }
  }
}
