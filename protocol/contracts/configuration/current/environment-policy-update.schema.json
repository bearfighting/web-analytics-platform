{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-analytics-platform.dev/contracts/configuration/current/environment-policy-update.schema.json",
  "title": "Environment Ingest Policy Update",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "allowed_origins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https?://[^/]+/?$"
      }
    },
    "rate_limit_per_minute": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": ["enabled", "allowed_origins", "rate_limit_per_minute"],
  "additionalProperties": false
}
