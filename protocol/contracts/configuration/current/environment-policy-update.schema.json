{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-analytics-platform.dev/contracts/configuration/current/environment-policy-update.schema.json",
  "title": "Environment Ingest Policy Update",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "allowed_origins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https?://(([A-Za-z0-9-]+\\.)*[A-Za-z0-9-]*[A-Za-z][A-Za-z0-9-]*|(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|\\[[A-Fa-f0-9.]*:[A-Fa-f0-9:.]*\\])(:(0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?/?$"
      }
    },
    "rate_limit_per_minute": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": ["enabled", "allowed_origins", "rate_limit_per_minute"],
  "additionalProperties": false
}
