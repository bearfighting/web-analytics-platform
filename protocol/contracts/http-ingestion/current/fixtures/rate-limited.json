{
  "id": "rate-limited",
  "setup": {
    "config": "../config/collector.example.toml",
    "rate_limit": {
      "site_id": "site_example",
      "origin": "https://www.example.com",
      "requests": 601
    }
  },
  "request": {
    "method": "POST",
    "path": "/v1/events",
    "headers": {
      "content-type": "application/json",
      "origin": "https://www.example.com",
      "x-ingest-key": "public-key-production-example"
    },
    "body": "{\"schema_version\":1,\"events\":[{\"schema_version\":1,\"event_id\":\"01J00000000000000000000000\",\"type\":\"page_view\",\"site_id\":\"site_example\",\"occurred_at\":1760000000000,\"path\":\"/about\"}]}"
  },
  "expected": {
    "status": 429,
    "headers": {
      "content-type": "application/json",
      "access-control-allow-origin": "https://www.example.com",
      "vary": "Origin",
      "retry-after": "60"
    },
    "body": "{\"error\":{\"code\":\"rate_limited\",\"message\":\"Rate limit exceeded\"}}"
  }
}
