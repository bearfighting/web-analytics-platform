{
  "id": "page_views",
  "status": "implemented",
  "depends_on": [],
  "input": {
    "event_types": ["page_view"],
    "required_fields": ["site_id", "path", "occurred_at"]
  },
  "raw_event": {
    "preserve": true,
    "fields": ["event_id", "site_id", "path", "occurred_at", "received_at"]
  },
  "processor": {
    "facts": ["page_view_daily", "page_view_routes", "page_view_totals"],
    "rebuild": "incremental"
  },
  "api": {
    "query_surface": "overview",
    "routes": ["/v1/sites/{site_id}/overview", "/v1/sites/{site_id}/reports/{from}/{to}/overview"]
  },
  "dashboard": {
    "surface": "overview",
    "disabled": "page views remain enabled as the baseline capability",
    "empty": "return zero metrics and empty tables",
    "error": "show the dashboard error state without exposing storage details"
  },
  "security": {
    "consent": "required",
    "origin_and_ingest_key": "enforced",
    "privacy": ["do not persist IP", "site isolation is required"]
  },
  "history": { "queryable_after_disabled": true, "backfill": "optional" }
}
