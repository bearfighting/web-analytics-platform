{
  "capability_schema_version": 1,
  "capabilities": [
    {
      "id": "page_views",
      "status": "implemented",
      "depends_on": [],
      "input": {
        "event_types": ["page_view"],
        "required_fields": ["site_id", "path", "occurred_at"]
      },
      "raw_event": {
        "preserve": true,
        "fields": ["event_id", "site_id", "path", "occurred_at", "received_at"]
      },
      "processor": {
        "facts": ["page_view_daily", "page_view_routes", "page_view_totals"],
        "rebuild": "incremental"
      },
      "api": {
        "query_surface": "overview",
        "routes": [
          "/v1/sites/{site_id}/overview",
          "/v1/sites/{site_id}/reports/{from}/{to}/overview"
        ]
      },
      "dashboard": {
        "surface": "overview",
        "disabled": "page views remain enabled as the baseline capability",
        "empty": "return zero metrics and empty tables",
        "error": "show the dashboard error state without exposing storage details"
      },
      "security": {
        "consent": "required",
        "origin_and_ingest_key": "enforced",
        "privacy": ["do not persist IP", "site isolation is required"]
      },
      "history": { "queryable_after_disabled": true, "backfill": "optional" }
    },
    {
      "id": "browser_context",
      "status": "implemented",
      "depends_on": ["page_views"],
      "input": {
        "event_types": ["page_view"],
        "required_fields": ["context", "context_schema_version"]
      },
      "raw_event": { "preserve": true, "fields": ["context", "context_schema_version"] },
      "processor": {
        "facts": ["normalized_event_context", "dimension_event_facts"],
        "rebuild": "explicit_backfill"
      },
      "api": {
        "query_surface": "report",
        "routes": ["/v1/sites/{site_id}/reports/{from}/{to}/dimensions/{dimension}"]
      },
      "dashboard": {
        "surface": "report",
        "disabled": "page views remain available without context-derived reports",
        "empty": "show no dimension rows for the selection",
        "error": "show the report error state"
      },
      "security": {
        "consent": "required",
        "origin_and_ingest_key": "enforced",
        "privacy": [
          "do not expose raw user-agent",
          "do not persist IP",
          "discard unsupported context fields"
        ]
      },
      "history": { "queryable_after_disabled": true, "backfill": "required" }
    },
    {
      "id": "anonymous_visitors",
      "status": "implemented",
      "depends_on": ["page_views"],
      "input": { "event_types": ["page_view"], "required_fields": ["visitor_id"] },
      "raw_event": { "preserve": true, "fields": ["visitor_id"] },
      "processor": {
        "facts": ["visitor_event_facts", "visitor_daily"],
        "rebuild": "explicit_backfill"
      },
      "api": {
        "query_surface": "report",
        "routes": ["/v1/sites/{site_id}/reports/{from}/{to}/visitors"]
      },
      "dashboard": {
        "surface": "report",
        "disabled": "page views remain available and visitor reports are unavailable",
        "empty": "show zero visitors and sessions",
        "error": "show the report error state"
      },
      "security": {
        "consent": "required",
        "origin_and_ingest_key": "enforced",
        "privacy": [
          "use site-scoped anonymous IDs",
          "do not use fingerprinting",
          "do not expose raw identity sources"
        ]
      },
      "history": { "queryable_after_disabled": true, "backfill": "required" }
    },
    {
      "id": "sessions",
      "status": "implemented",
      "depends_on": ["anonymous_visitors"],
      "input": { "event_types": ["page_view"], "required_fields": ["visitor_id", "occurred_at"] },
      "raw_event": { "preserve": false, "fields": [] },
      "processor": {
        "facts": ["session_events", "sessions", "session_daily"],
        "rebuild": "explicit_backfill"
      },
      "api": {
        "query_surface": "report",
        "routes": ["/v1/sites/{site_id}/reports/{from}/{to}/sessions"]
      },
      "dashboard": {
        "surface": "report",
        "disabled": "page views remain available and session reports are unavailable",
        "empty": "show zero sessions",
        "error": "show the report error state"
      },
      "security": {
        "consent": "required",
        "origin_and_ingest_key": "enforced",
        "privacy": ["sessions require anonymous visitor IDs", "do not expose raw identity sources"]
      },
      "history": { "queryable_after_disabled": true, "backfill": "required" }
    },
    {
      "id": "dimensions",
      "status": "implemented",
      "depends_on": ["browser_context"],
      "input": { "event_types": ["page_view"], "required_fields": ["context"] },
      "raw_event": { "preserve": false, "fields": [] },
      "processor": {
        "facts": ["dimension_event_facts", "dimension_daily"],
