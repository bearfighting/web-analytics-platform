{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-analytics-platform.dev/schemas/events/page-view-event.schema.json",
  "title": "Page View Event",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "const": "page_view"
    },
    "site_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "occurred_at": {
      "type": "integer",
      "minimum": 0
    },
    "url": {
      "type": "string",
      "format": "uri",
      "maxLength": 4096
    },
    "path": {
      "type": "string",
      "pattern": "^/",
      "maxLength": 2048
    },
    "title": {
      "type": "string",
      "maxLength": 512
    },
    "referrer": {
      "type": "string",
      "format": "uri-reference",
      "maxLength": 4096
    },
    "visitor_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "context_schema_version": { "const": 1 },
    "session_id": false,
    "context": { "$ref": "../contexts/browser-context.schema.json" }
  },
  "required": ["schema_version", "event_id", "type", "site_id", "occurred_at", "path"],
  "allOf": [
    {
      "if": { "properties": { "context": {} }, "required": ["context"] },
      "then": {
        "properties": { "context_schema_version": {} },
        "required": ["context_schema_version"]
      }
    },
    {
      "if": {
        "properties": { "context_schema_version": {} },
        "required": ["context_schema_version"]
      },
      "then": { "properties": { "context": {} }, "required": ["context"] }
    }
  ],
  "additionalProperties": true
}
