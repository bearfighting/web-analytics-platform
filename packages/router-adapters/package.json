{
  "name": "@web-analytics/router-adapters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./react-router": {
      "types": "./dist/react-router.d.ts",
      "import": "./dist/react-router.js"
    },
    "./tanstack-router": {
      "types": "./dist/tanstack-router.d.ts",
      "import": "./dist/tanstack-router.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "format": "prettier --write src package.json tsconfig.json tsconfig.typecheck.json vitest.config.ts README.md",
    "format:check": "prettier --check src package.json tsconfig.json tsconfig.typecheck.json vitest.config.ts README.md"
  },
  "dependencies": {
    "@web-analytics/analytics-browser": "workspace:*",
    "@web-analytics/observer-core": "workspace:*",
    "@web-analytics/observer-next": "workspace:*",
    "@web-analytics/observer-react-router": "workspace:*",
    "@web-analytics/observer-tanstack-router": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-router": ">=1 <2",
    "next": ">=16 <17",
    "react": ">=19 <20",
    "react-dom": ">=19 <20",
    "react-router-dom": ">=7 <8"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-router": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-router": "^1.170.39",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "next": "16.3.6",
    "prettier": "^3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.18.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
