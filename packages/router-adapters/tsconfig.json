{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@web-analytics/analytics-browser": ["../analytics-browser/src/index.ts"],
      "@web-analytics/observer-core": ["../observer-core/src/index.ts"],
      "@web-analytics/observer-next": ["../observer-next/src/index.ts"],
      "@web-analytics/observer-react-router": ["../observer-react-router/src/index.ts"],
      "@web-analytics/observer-tanstack-router": ["../observer-tanstack-router/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "references": [
    { "path": "../analytics-browser" },
    { "path": "../observer-next" },
    { "path": "../observer-react-router" },
    { "path": "../observer-tanstack-router" }
  ]
}
