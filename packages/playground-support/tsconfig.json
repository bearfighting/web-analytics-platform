{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@web-analytics/analytics-core": ["../../packages/analytics-core/src/index.ts"],
      "@web-analytics/protocol-ts": ["../../packages/protocol-ts/src/index.ts"],
      "@web-analytics/observer-core": ["../../packages/observer-core/src/index.ts"],
      "@web-analytics/transport": ["../../packages/transport/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "references": [
    { "path": "../analytics-core" },
    { "path": "../protocol-ts" },
    { "path": "../transport" }
  ]
}
