{
  "name": "@web-analytics/observer-tanstack-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "format": "prettier --write src package.json tsconfig.json tsconfig.typecheck.json vitest.config.ts README.md",
    "format:check": "prettier --check src package.json tsconfig.json tsconfig.typecheck.json vitest.config.ts README.md"
  },
  "dependencies": {
    "@web-analytics/observer-core": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-router": ">=1 <2",
    "react": ">=19 <20"
  },
  "devDependencies": {
    "@tanstack/react-router": "^1.120.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "prettier": "^3.9.7",
    "typescript": "^5.7.3",
    "vitest": "^3.0.9"
  }
}
