{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@web-analytics/analytics-browser": ["../../packages/analytics-browser/src/index.ts"],
      "@web-analytics/analytics-core": ["../../packages/analytics-core/src/index.ts"],
      "@web-analytics/observer-core": ["../../packages/observer-core/src/index.ts"],
      "@web-analytics/observer-next": ["../../packages/observer-next/src/index.ts"],
      "@web-analytics/playground-support": ["../../packages/playground-support/src/index.ts"],
      "@web-analytics/router-adapters/next": ["../../packages/router-adapters/src/next.tsx"],
      "@web-analytics/protocol-ts": ["../../packages/protocol-ts/src/index.ts"],
      "@web-analytics/transport": ["../../packages/transport/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
