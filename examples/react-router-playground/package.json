{
  "name": "@web-analytics/react-router-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"console.log('Browser coverage is provided by e2e:router-adapters')\"",
    "format": "prettier --write src index.html vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src index.html vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "@web-analytics/analytics-core": "workspace:*",
    "@web-analytics/analytics-browser": "workspace:*",
    "@web-analytics/observer-core": "workspace:*",
    "@web-analytics/observer-react-router": "workspace:*",
    "@web-analytics/protocol-ts": "workspace:*",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.7",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
