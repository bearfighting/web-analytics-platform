# Collector configuration path used by the Phase 2 development service.
COLLECTOR_CONFIG=./protocol/http/config/collector.example.toml

# Playground uses MockTransport by default. Set these values to send to the local Collector.
NEXT_PUBLIC_ANALYTICS_TRANSPORT=mock
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
NEXT_PUBLIC_ANALYTICS_INGEST_KEY=
NEXT_PUBLIC_ANALYTICS_SITE_ID=site_playground
