{
  "name": "web-analytics-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "./scripts/dev.sh",
    "check": "./scripts/check.sh",
    "test": "./scripts/test.sh",
    "test:integration": "./scripts/test-integration.sh",
    "build": "./scripts/build.sh",
    "format": "./scripts/format.sh",
    "format:check": "./scripts/format-check.sh",
    "docker:dev": "./scripts/docker-dev.sh",
    "docker:backend": "./scripts/docker-backend.sh",
    "db:migrate": "cargo run -p collector -- migrate",
    "protocol:validate": "node ./scripts/validate-protocol.mjs",
    "http:validate": "node ./scripts/validate-http-fixtures.mjs",
    "analytics:contract:validate": "node ./scripts/validate-phase3-contract.mjs",
    "build:packages": "pnpm --filter @web-analytics/protocol-ts --filter @web-analytics/observer-core --filter @web-analytics/observer-next --filter @web-analytics/analytics-core --filter @web-analytics/analytics-browser --filter @web-analytics/transport build"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.20.1",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.9.7",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "ulid": "^2.3.0",
    "vitest": "^3.0.9"
  }
}
